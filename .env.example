JARVIS_OBSIDIAN_VAULT_PATH=
JARVIS_MCP_ENABLED=false
JARVIS_MCP_CONFIG_PATH=data/mcp_servers.yaml
JARVIS_MCP_TOOLS_CACHE_TTL_SECONDS=300
JARVIS_OTEL_ENABLED=false
JARVIS_OTEL_SERVICE_NAME=jarvis-api
JARVIS_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
JARVIS_OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
JARVIS_OTEL_TRACES_SAMPLER=parentbased_traceidratio
JARVIS_OTEL_TRACES_SAMPLER_ARG=1.0
JARVIS_OTEL_CAPTURE_CONTENT=true

# Local Langfuse observability stack.
# These defaults match docker-compose.langfuse.yml and bootstrap a local project.
LANGFUSE_INIT_ORG_ID=jarvis-local-org
LANGFUSE_INIT_ORG_NAME=Jarvis Local
LANGFUSE_INIT_PROJECT_ID=jarvis-local-project
LANGFUSE_INIT_PROJECT_NAME=Jarvis Local
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-jarvis-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-jarvis-local
LANGFUSE_INIT_USER_EMAIL=admin@jarvis.local
LANGFUSE_INIT_USER_NAME=Jarvis Admin
LANGFUSE_INIT_USER_PASSWORD=jarvis-local-admin
LANGFUSE_OTEL_AUTH_HEADER=Basic cGstbGYtamFydmlzLWxvY2FsOnNrLWxmLWphcnZpcy1sb2NhbA==

