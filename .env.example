JARVIS_LLM_TIMEOUT_SECONDS=60
JARVIS_REACT_RUNTIME_BACKEND=builtin
JARVIS_RESULT_AGGREGATOR_BACKEND=llm
JARVIS_DEEPSEEK_API_KEY=
JARVIS_DEEPSEEK_BASE_URL=https://api.deepseek.com
JARVIS_DEEPSEEK_MODEL=deepseek-v4-flash
JARVIS_KIMI_API_KEY=
